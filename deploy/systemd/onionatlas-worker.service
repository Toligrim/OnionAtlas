[Unit]
Description=OnionAtlas disposable Tor crawl worker
After=network-online.target tor.service
Wants=network-online.target tor.service

[Service]
Type=simple
User=onionatlas-worker
Group=onionatlas-worker
EnvironmentFile=/etc/onionatlas/worker.env
WorkingDirectory=/opt/onionatlas
ExecStart=/opt/onionatlas/.venv/bin/onionatlas worker run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/onionatlas-worker

[Install]
WantedBy=multi-user.target
